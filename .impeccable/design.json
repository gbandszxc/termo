  "narrative": {
    "northStar": "安静的驾驶舱（The Quiet Cockpit）",
    "overview": "Termo 的界面是一间深夜机房旁的驾驶舱：仪表都在，但没有一块仪表在抢戏。工作区永远是最暗（深色）或最亮（浅色）的那块风挡玻璃；强调蓝是舱内唯一的信号灯——只指示可操作与正在发生，从不参与装饰。信息密度对齐专业工具（VS Code 的骨架、Xcode 的克制、Ghostty 的终端观感），密度不是噪音，无序才是。颜色变量沿用 Catppuccin 词汇（crust/mantle/base/mauve），深色取值为 VS Code 经典配色，浅色换用 Tailwind 500 号色板；所有界面自绘 SwiftUI，系统原生控件外观一律禁用。",
    "keyCharacteristics": [
      "四级表面梯度 + 半透明叠加层表达一切层级，几乎不用阴影",
      "唯一强调色双主题切换：深色 #569cd6 → 浅色 #3b82f6",
      "交互反馈全部 easeOut 0.12–0.18s 短过渡",
      "状态永远颜色 + 文字/图标双通道",
      "圆角语言收敛在 6/7/8/14 四档"
    ],
    "rules": [
      {
        "name": "光落工作区",
        "body": "表面梯度方向永远把光导向工作区：深色 crust(亮)→mantle→base(暗)，浅色 base(亮)→mantle→crust(暗)。新面板必须落进这四级，不许发明第五档底色。",
        "section": "colors"
      },
      {
        "name": "信号灯",
        "body": "强调蓝任一屏占比 ≤10%。选中底、聚焦框、主按钮是它的全部舞台；列表、图表、正文不得大面积使用。",
        "section": "colors"
      },
      {
        "name": "三档",
        "body": "UI 文本只在 11/12/13px 三档里选；往上只有标题（15/16），往下只有徽标（9–10px）。禁止为强调而放大正文。",
        "section": "typography"
      },
      {
        "name": "描边即边界",
        "body": "卡片与输入框不靠阴影区分于背景，靠 fill(0.08–0.12) 的 1px 描边；阴影只给悬浮物（对话框、分段药丸、开关旋钮）。",
        "section": "elevation"
      }
    ],
    "dos": [
      "新面板从四级表面梯度里选底色，深浅两套同时校验",
      "用 fill(0.04–0.12) 表达 hover/选中/描边",
      "所有交互反馈用 easeOut 0.12–0.18s",
      "状态用颜色+文字双通道",
      "行内等宽字体呈现路径、命令、数值",
      "可点击元素一律手型光标 + 自绘 tooltip"
    ],
    "donts": [
      "禁用系统原生控件外观（focus ring、原生开关、原生弹窗）",
      "强调蓝不超过一屏 ~10%，不作装饰/图表色",
      "不发明第五档底色或新圆角档位",
      "不给容器加阴影",
      "不用放大字号做强调",
      "不跨主题复用取值；不用纯白/纯黑做大面积底色"
    ]
  }
}